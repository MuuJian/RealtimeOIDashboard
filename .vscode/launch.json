{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Realtime OI Dashboard",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "--host",
        "0.0.0.0",
        "--port",
        "8777",
        "--oi-batch-size",
        "25",
        "--oi-batch-delay",
        "1",
        "--oi-workers",
        "3"
      ],
      "serverReadyAction": {
        "pattern": "Dashboard running at http://\\S+:(\\d+)",
        "uriFormat": "http://127.0.0.1:%s",
        "action": "openExternally"
      }
    }
  ]
}
